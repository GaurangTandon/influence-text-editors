{
  "manifest_version": 3,
  "name": "influence-text-editors probe",
  "version": "1.0",
  "description": "Runs this project's strategies from an extension content script, so the isolated world can be measured against the same five editors.",
  "browser_specific_settings": {
    "gecko": {
      "id": "influence-text-editors@example.invalid",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["clipboardRead", "clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["content-isolated.js"]
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "world": "MAIN",
      "js": ["content-main.js"]
    }
  ]
}