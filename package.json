{
  "name": "influence-text-editors",
  "version": "1.0.0",
  "private": true,
  "description": "Which strategies can modify a rich text editor from outside it? Measured against stock ProseMirror, Wordgard, Quill 2, CodeMirror 6 and CKEditor 5 in Chromium, Firefox and WebKit.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "serve": "node serve.mjs",
    "test": "node test/verify.mjs",
    "test:all": "node test/verify.mjs chromium firefox webkit",
    "test:firefox": "node test/verify.mjs firefox",
    "test:webkit": "node test/verify.mjs webkit",
    "measure": "node test/harness.mjs",
    "setup:webkit": "bash scripts/setup-webkit-deps.sh",
    "tables": "node test/tables.mjs",
    "webkit": "bash tools/webkit.sh",
    "webkit:console": "node tools/webkit-console.mjs",
    "build:site": "node build.mjs"
  },
  "devDependencies": {
    "@ckeditor/ckeditor5-build-classic": "^41.4.2",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.63.0",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.5",
    "quill": "^2.0.3",
    "wordgard": "^0.5.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/johanneswilm/influence-text-editors"
  },
  "homepage": "https://johanneswilm.github.io/influence-text-editors/",
  "keywords": [
    "beforeinput",
    "getTargetRanges",
    "execCommand",
    "contenteditable",
    "prosemirror",
    "wordgard",
    "quill",
    "codemirror",
    "ckeditor",
    "rich-text"
  ]
}
